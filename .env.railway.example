# Environment variables to set in Railway (Project -> Variables)

# Required. If you add a Railway Postgres plugin to this project and attach
# it to this service, Railway injects DATABASE_URL automatically - you won't
# need to set it by hand.
# DATABASE_URL=postgres://user:password@host:port/dbname

# Required
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# Leave unset in production - Railway serves the frontend and API from the
# same domain, so the app uses relative API paths automatically.
# REACT_APP_API_BASE=

# Railway sets PORT automatically - no need to set it yourself.
# Railway sets NODE_ENV=production by default, which enables SSL for the
# Postgres connection. If you connect to a Postgres instance that doesn't
# support/require SSL, set PGSSL=false to disable it.
