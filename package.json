{
  "name": "hr-post-selection-app",
  "version": "1.1.0",
  "description": "Desktop HR application for post-selection processes",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "HR Team",
  "license": "MIT",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test",
    "react-eject": "react-scripts eject",
    "electron-start": "electron .",
    "electron-dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run react-build && electron-builder",
    "build": "npm run react-build && npm run electron-build",
    "start": "npm run electron-dev",
    "server": "node server.js",
    "web-build": "react-scripts build",
    "web-start": "node server.js"
  },
  "proxy": "http://localhost:3001",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "axios": "^1.7.2",
    "better-sqlite3": "^11.1.2",
    "pg": "^8.13.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "moment": "^2.30.1",
    "uuid": "^10.0.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "xlsx": "^0.18.5",
    "papaparse": "^5.4.1",
    "recharts": "^2.12.7",
    "lucide-react": "^0.414.0"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "typescript": "^5.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.14.12",
    "tailwindcss": "^3.4.6",
    "postcss": "^8.4.40",
    "autoprefixer": "^10.4.19"
  },
  "build": {
    "appId": "com.hr.postselection",
    "productName": "HR Post-Selection Manager",
    "files": [
      "build/**/*",
      "public/electron.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
